      "source": [
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "# Map credit risk for better readability\n",
        "risk_map = {1: 'Low Risk (Good)', 2: 'High Risk (Bad)'}\n",
        "df_status['Credit Risk'] = df_status['credit_risk'].map(risk_map)\n",
        "\n",
        "# Calculate descriptive statistics for duration by risk group\n",
        "duration_stats = df_status.groupby('Credit Risk')['duration_months'].describe()\n",
        "print(\"--- Descriptive Statistics of Credit Duration (Months) ---\")\n",
        "display(duration_stats)\n",
        "\n",
        "# Create subplots\n",
        "fig, axes = plt.subplots(1, 2, figsize=(14, 6))\n",
        "sns.set_theme(style=\"whitegrid\")\n",
        "\n",
        "# Plot 1: Boxplot to compare distributions and medians\n",
        "sns.boxplot(\n",
        "    data=df_status,\n",
        "    x='Credit Risk',\n",
        "    y='duration_months',\n",
        "    palette='Set1',\n",
        "    ax=axes[0],\n",
        "    hue='Credit Risk',\n",
        "    legend=False\n",
        ")\n",
        "axes[0].set_title('Comparison of Credit Duration (Months) by Risk Category')\n",
        "axes[0].set_xlabel('Credit Risk')\n",
        "axes[0].set_ylabel('Duration (Months)')\n",
        "\n",
        "# Plot 2: KDE/Histogram showing count of customers over duration range\n",
        "sns.histplot(\n",
        "    data=df_status,\n",
        "    x='duration_months',\n",
        "    hue='Credit Risk',\n",
        "    multiple='dodge',\n",
        "    kde=True,\n",
        "    palette='Set1',\n",
        "    ax=axes[1],\n",
        "    shrink=0.8\n",
        ")\n",
        "axes[1].set_title('Customer Count Distribution across Credit Durations')\n",
        "axes[1].set_xlabel('Duration (Months)')\n",
        "axes[1].set_ylabel('Number of Customers')\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
