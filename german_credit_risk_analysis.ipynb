      "source": [
        "# Group by credit_risk and calculate the mean of credit_amount\n",
        "# This shows that, on average, individuals classified under bad credit risk requested larger credit amounts compared to those with good credit risk.\n",
        "mean_credit_by_risk = df_credit.groupby('credit_risk')['credit_amount'].mean().reset_index()\n",
        "\n",
        "# Display the resulting DataFrame\n",
        "display(mean_credit_by_risk)"
      ],
