      "source": [
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "# Map codes for personal_status_sex based on UCI documentation:\n",
        "# A91 : male : divorced/separated\n",
        "# A92 : female : divorced/separated/married\n",
        "# A93 : male : single\n",
        "# A94 : male : married/widowed\n",
        "# A95 : female : single\n",
        "personal_status_map = {\n",
        "    'A91': 'Male: Divorced/Separated',\n",
        "    'A92': 'Female: Divorced/Separated/Married',\n",
        "    'A93': 'Male: Single',\n",
        "    'A94': 'Male: Married/Widowed',\n",
        "    'A95': 'Female: Single'\n",
        "}\n",
        "\n",
        "# Map credit risk\n",
        "risk_map = {\n",
        "    1: 'Low Risk (Good)',\n",
        "    2: 'High Risk (Bad)'\n",
        "}\n",
        "\n",
        "# Creating copy of dataframe and apply mapping\n",
        "df_status = df_credit.copy()\n",
        "df_status['Personal Status & Sex'] = df_status['personal_status_sex'].map(personal_status_map)\n",
        "df_status['Credit Risk'] = df_status['credit_risk'].map(risk_map)\n",
        "\n",
        "# Creating cross tabulation to get exact figures\n",
        "ct = pd.crosstab(df_status['Personal Status & Sex'], df_status['Credit Risk'])\n",
        "print(\"--- Summary of Credit Risk by Personal Status & Sex ---\")\n",
        "display(ct)\n",
        "\n",
        "# Plotting the results\n",
        "plt.figure(figsize=(12, 6))\n",
        "sns.set_theme(style=\"whitegrid\")\n",
        "\n",
        "ax = sns.countplot(\n",
        "    data=df_status,\n",
        "    x='Personal Status & Sex',\n",
        "    hue='Credit Risk',\n",
        "    palette='Set1'\n",
        ")\n",
        "\n",
        "plt.title('Distribution of Credit Risk by Personal Status and Sex')\n",
        "plt.xlabel('Personal Status & Sex')\n",
        "plt.ylabel('Number of Applicants')\n",
        "plt.xticks(rotation=15, ha='right')\n",
        "plt.legend(title='Credit Risk')\n",
        "\n",
        "# Add count labels on top of the bars\n",
        "for container in ax.containers:\n",
        "    ax.bar_label(container)\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
