        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "# Map purpose numeric categories to descriptive text labels\n",
        "# Purpose codes from UCI documentation:\n",
        "purpose_map = {\n",
        "    'A40': 'Car (new)',\n",
        "    'A41': 'Car (used)',\n",
        "    'A42': 'Furniture/Equipment',\n",
        "    'A43': 'Radio/Television',\n",
        "    'A44': 'Domestic Appliances',\n",
        "    'A45': 'Repairs',\n",
        "    'A46': 'Education',\n",
        "    'A47': 'Vacation (does not exist)',\n",
        "    'A48': 'Retraining',\n",
        "    'A49': 'Business',\n",
        "    'A410': 'Others'\n",
        "}\n",
        "\n",
        "# Ensure df_credit is present\n",
        "try:\n",
        "    df_credit\n",
        "except NameError:\n",
        "    url = 'https://archive.ics.uci.edu/ml/machine-learning-databases/statlog/german/german.data'\n",
        "    columns = [\n",
        "        'status_existing_checking_account', 'duration_months', 'credit_history',\n",
        "        'purpose', 'credit_amount', 'savings_account_bonds', 'present_employment_since',\n",
        "        'installment_rate_disposable_income', 'personal_status_sex', 'other_debtors_guarantors',\n",
        "        'present_residence_since', 'property', 'age_years', 'other_installment_plans',\n",
        "        'housing', 'number_credits_this_bank', 'job', 'number_people_liable_maintenance',\n",
        "        'telephone', 'foreign_worker', 'credit_risk'\n",
        "    ]\n",
        "    df_credit = pd.read_csv(url, sep=' ', names=columns)\n",
        "\n",
        "# Create a working copy and map purpose\n",
        "df_purpose = df_credit.copy()\n",
        "df_purpose['Purpose Label'] = df_purpose['purpose'].map(purpose_map)\n",
        "\n",
        "# Calculating the percentage of High Risk (credit_risk = 2) for each purpose\n",
        "purpose_risk = df_purpose.groupby('Purpose Label')['credit_risk'].agg(\n",
        "    total_loans='count',\n",
        "    high_risk_loans=lambda x: (x == 2).sum()\n",
        ").reset_index()\n",
        "\n",
        "purpose_risk['High Risk %'] = (purpose_risk['high_risk_loans'] / purpose_risk['total_loans']) * 100\n",
        "purpose_risk = purpose_risk.sort_values(by='High Risk %', ascending=False)\n",
        "\n",
        "# Plotting\n",
        "plt.figure(figsize=(12, 6))\n",
        "sns.set_theme(style=\"whitegrid\")\n",
        "\n",
        "ax = sns.barplot(\n",
        "    data=purpose_risk,\n",
        "    y='Purpose Label',\n",
        "    x='High Risk %',\n",
        "    palette='Oranges_r'\n",
        ")\n",
        "\n",
        "plt.title('Percentage of High Risk Loans by Credit Purpose')\n",
        "plt.xlabel('Percentage of Loans Classified as High Risk (%)')\n",
        "plt.ylabel('Credit Purpose')\n",
        "\n",
        "# Add values to the bars\n",
        "for i, v in enumerate(purpose_risk['High Risk %']):\n",
        "    ax.text(v + 1, i, f\"{v:.1f}% (of {purpose_risk.iloc[i]['total_loans']})\", va='center')\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
