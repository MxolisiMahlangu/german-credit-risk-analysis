      "source": [
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "# Set the style\n",
        "sns.set_theme(style=\"whitegrid\")\n",
        "\n",
        "# Create subplots\n",
        "fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
        "\n",
        "# Plot 1: Age distribution (Numerical)\n",
        "sns.histplot(data=df_credit, x='age_years', kde=True, ax=axes[0], color='skyblue')\n",
        "axes[0].set_title('Distribution of Age (years)')\n",
        "axes[0].set_xlabel('Age')\n",
        "axes[0].set_ylabel('Count')\n",
        "\n",
        "# Plot 2: Foreign worker distribution (Categorical) - warning fixed by adding hue and legend=False\n",
        "sns.countplot(data=df_credit, x='foreign_worker', hue='foreign_worker', ax=axes[1], palette='pastel', legend=False)\n",
        "axes[1].set_title('Distribution of Foreign Workers')\n",
        "axes[1].set_xlabel('Foreign Worker Status (A201 = Yes, A202 = No)')\n",
        "axes[1].set_ylabel('Count')\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
      "execution_count": null,
